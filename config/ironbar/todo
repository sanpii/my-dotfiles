#!/bin/bash

main() {
    local fn=${1-short}

    case $fn in
        "dialog")
            dialog
        ;;
        "short")
            short 2> /dev/null || echo '×'
        ;;
    esac
}

short() {
    source ~/.todo/config

    do_short

    inotifywait --event close_write --monitor "$TODO_FILE" | while read
    do
        do_short
    done
}

do_short() {
    n=$(todo-txt-cli | head -n -2 | wc -l)
    pri=$(todo-txt-cli | head -n -2 | sed  's/.* (\([A-Z]\)) .*/\1/' | sort -u)

    case $pri in
        "A")
            color="#BF616A"
        ;;
        "B")
            color="#EBCB8B"
        ;;
        "C")
            color="#88C0D0"
        ;;
        *)
            color="#FFFFFF"
        ;;
    esac

    if [[ "$n" == 0 ]]
    then
        n='-'
    fi

    echo "<span foreground='$color'> $n</span>"
}

dialog() {
    export GTK_THEME=Arc-Darker:dark
    local todo=$(todo-txt-cli | head -n -2)

    if [[ -n "$todo" ]]
    then
        echo "$todo" | yad --name=yad.toolbar.todo --list --column=task --no-headers --undecorated --button yad-close:0 --mouse --width=500 --height=300
    fi
}

main $*
